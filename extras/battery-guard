#!/usr/bin/env bash
#
# battery-guard - Native Linux Battery Lifespan & Charge Threshold Manager
#
# Caps battery charging (default: 80%) to prevent battery degradation when plugged in.
# Uses 100% native Linux kernel sysfs interfaces (no TLP, no extra dependencies).
#
# Usage:
#   battery-guard status         # Show current battery charge threshold
#   sudo battery-guard 80        # Cap maximum charging at 80% (recommended for desk use)
#   sudo battery-guard 100       # Restore full 100% charging (for travel)
#   sudo battery-guard on        # Enable 80% conservation mode
#   sudo battery-guard off       # Disable conservation mode (allow 100%)
#

set -euo pipefail

# Find all battery threshold control nodes across various vendor drivers
find_threshold_nodes() {
    local nodes=()
    for f in /sys/class/power_supply/BAT*/charge_control_end_threshold \
             /sys/class/power_supply/BAT*/charge_stop_threshold \
             /sys/bus/platform/devices/VPC2004:*/conservation_mode \
             /sys/bus/platform/drivers/ideapad_laptop/VPC2004:*/conservation_mode; do
        if [ -f "$f" ]; then
            nodes+=("$f")
        fi
    done
    echo "${nodes[@]:-}"
}

get_status() {
    echo "============================================================"
    echo "  BatteryGuard: Hardware Charge Threshold Status"
    echo "============================================================"

    local found=0
    for bat in /sys/class/power_supply/BAT*; do
        [ -d "$bat" ] || continue
        found=1
        local name
        name="$(basename "$bat")"
        local cap="unknown"
        local status="unknown"
        [ -f "$bat/capacity" ] && cap="$(cat "$bat/capacity")%"
        [ -f "$bat/status" ] && status="$(cat "$bat/status")"

        echo "Battery: $name"
        echo "  • Current Charge : $cap ($status)"

        if [ -f "$bat/charge_control_end_threshold" ]; then
            local end_th
            end_th="$(cat "$bat/charge_control_end_threshold")"
            echo "  • Charge Limit   : $end_th% (charge_control_end_threshold)"
        elif [ -f "$bat/charge_stop_threshold" ]; then
            local stop_th
            stop_th="$(cat "$bat/charge_stop_threshold")"
            echo "  • Charge Limit   : $stop_th% (charge_stop_threshold)"
        fi
    done

    # Check vendor ACPI nodes (Lenovo/Asus/etc.)
    for node in /sys/bus/platform/devices/VPC2004:*/conservation_mode; do
        if [ -f "$node" ]; then
            local cm
            cm="$(cat "$node")"
            echo "Lenovo Conservation Mode: $([ "$cm" = "1" ] && echo "Active (Capped ~80%)" || echo "Off (Charges to 100%)")"
        fi
    done

    if [ "$found" -eq 0 ]; then
        echo "No battery found (desktop/server system)."
    fi
    echo "============================================================"
}

set_threshold() {
    local target="$1"

    if [ "$target" = "on" ] || [ "$target" = "enable" ]; then
        target=80
    elif [ "$target" = "off" ] || [ "$target" = "disable" ]; then
        target=100
    fi

    if ! [[ "$target" =~ ^[0-9]+$ ]] || [ "$target" -lt 50 ] || [ "$target" -gt 100 ]; then
        echo "Error: Target threshold must be a number between 50 and 100 (e.g. 80), or 'on'/'off'."
        exit 1
    fi

    if [ "$(id -u)" -ne 0 ]; then
        echo "Error: Modifying battery charge thresholds requires root. Run with sudo."
        exit 1
    fi

    local applied=0

    # 1. Standard Linux kernel power supply threshold nodes
    for f in /sys/class/power_supply/BAT*/charge_control_end_threshold \
             /sys/class/power_supply/BAT*/charge_stop_threshold; do
        if [ -f "$f" ]; then
            echo "$target" > "$f" 2>/dev/null && applied=1 || true
        fi
    done

    # 2. Start threshold (if supported, keep start threshold 5% below end threshold)
    local start_target=$((target - 5))
    [ "$start_target" -lt 40 ] && start_target=40
    for f in /sys/class/power_supply/BAT*/charge_control_start_threshold \
             /sys/class/power_supply/BAT*/charge_start_threshold; do
        if [ -f "$f" ]; then
            echo "$start_target" > "$f" 2>/dev/null || true
        fi
    done

    # 3. Vendor ACPI conservation mode (Lenovo 0/1)
    for node in /sys/bus/platform/devices/VPC2004:*/conservation_mode; do
        if [ -f "$node" ]; then
            local cm_val=$([ "$target" -le 85 ] && echo "1" || echo "0")
            echo "$cm_val" > "$node" 2>/dev/null && applied=1 || true
        fi
    done

    if [ "$applied" -eq 1 ]; then
        echo "✓ Battery charge limit successfully set to ${target}%."
        if [ "$target" -le 85 ]; then
            echo "  (Battery health conservation active: stops charging at ${target}% to preserve lithium cells)."
        else
            echo "  (Full charge restored: battery will charge to 100%)."
        fi
    else
        echo "Warning: No supported hardware battery charge threshold interfaces found on this machine."
        exit 1
    fi
}

main() {
    local cmd="${1:-status}"

    case "$cmd" in
        status)
            get_status
            ;;
        -h|--help|help)
            echo "Usage: battery-guard [status | 80 | 100 | on | off]"
            echo ""
            echo "Commands:"
            echo "  battery-guard status   Show current battery charge threshold"
            echo "  battery-guard 80       Cap charging at 80% (recommended for desk/dock use)"
            echo "  battery-guard 100      Charge to 100% (for travel)"
            echo "  battery-guard on       Turn on 80% battery conservation"
            echo "  battery-guard off      Turn off conservation (charge to 100%)"
            ;;
        *)
            set_threshold "$cmd"
            ;;
    esac
}

main "$@"
