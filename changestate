STATE_FILE = "/var/run/changestate.state"

def save_active_state(name):
    """Record the active persona name to STATE_FILE."""
    try:
        with open(STATE_FILE, "w") as f:
            f.write(name)
    except PermissionError:
        subprocess.run(f"echo {name} | sudo tee {STATE_FILE} > /dev/null", shell=True, check=False)
    except Exception:
        pass

def get_active_state():
    """Read the active persona name from STATE_FILE."""
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "untracked / manual"

def show_status():
    print("========================================")
    print(f" Active Persona  : {get_active_state().upper()}")
    print("========================================")
    try:
        with open("/sys/firmware/acpi/platform_profile", "r") as f:
            print(f"Platform Profile : {f.read().strip()}")
    except Exception:
        pass

    try:
        with open("/sys/devices/system/cpu/cpufreq/policy0/scaling_governor", "r") as f:
            print(f"CPU Governor     : {f.read().strip()}")
    except Exception:
        pass

    try:
        with open("/sys/devices/system/cpu/cpufreq/boost", "r") as f:
            boost_val = f.read().strip()
            print(f"CPU Boost        : {'Enabled' if boost_val == '1' else 'Disabled'}")
    except Exception:
        pass

    try:
        with open("/sys/devices/system/cpu/online", "r") as f:
            online = f.read().strip()
            total_hw = get_total_cores()
            print(f"Online Cores     : {online} (out of 0-{total_hw - 1})")
    except Exception:
        pass

    try:
        with open("/sys/devices/system/cpu/cpufreq/policy0/energy_performance_preference", "r") as f:
            print(f"CPU EPP          : {f.read().strip()}")
    except Exception:
        pass

    try:
        gpu_nodes = glob.glob("/sys/class/drm/card*/device/power_dpm_force_performance_level")
        if gpu_nodes:
            with open(gpu_nodes[0], "r") as f:
                print(f"GPU Power Level  : {f.read().strip()}")
    except Exception:
        pass

    try:
        with open("/sys/class/power_supply/BAT0/capacity", "r") as f:
            cap = f.read().strip()
        with open("/sys/class/power_supply/BAT0/status", "r") as f:
            stat = f.read().strip()
        print(f"Battery          : {cap}% ({stat})")
    except Exception:
        pass

PERSONAS = {
    "server": apply_server,
    "mom": apply_mom,
    "lowlow": apply_lowlow,
    "mid": apply_mid,
    "eleven": apply_eleven,
    # Aliases for backwards compatibility
    "webdev": apply_mid,
    "inferencing": apply_eleven,
}

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print("Usage: changestate <persona> [--loop]")
        print("\nAvailable personas:")
        print("  server   - LOW-WATTAGE SERVER: GPU low floor (~200MHz, flawless terminal logs),")
        print("             4/2 cores base with 2.8GHz spike headroom, boost OFF, bloat purged.")
        print("             Add --loop for infinite dynamic prime-numbered core scaling (2->3->5->7->11->13)")
        print("  mom      - DEFENSE / ULTRA-QUIET: RF cut, camera dead, single core only,")
        print("             firewall lockdown, daemons purged. Hardwired Ethernet only.")
        print("  lowlow   - Low-power: Battery sipping, Wi-Fi ON, 1.6GHz CPU cap, GPU low, boost off")
        print("  mid      - Balanced: Wi-Fi ON, half cores, boost on, minimal GPU")
        print("  eleven   - Cranked to 11: All cores uncapped, GPU auto, full blast")
        print("  status   - Show current active persona & hardware state")
        sys.exit(0)

    target = sys.argv[1].lower()

    if target == "status":
        show_status()
        return

    if target not in PERSONAS:
        print(f"Error: Unknown persona '{target}'")
        print(f"Choices: {', '.join(PERSONAS.keys())}")
        sys.exit(1)

    daemon_mode = "--loop" in sys.argv or "-l" in sys.argv

    if target == "server":
        PERSONAS[target](daemon_mode=daemon_mode)
    else:
        PERSONAS[target]()

    save_active_state(target)
    run_cmd(f'notify-send "State Changed" "Activated {target.upper()} persona" -i preferences-system-power')

if __name__ == "__main__":
    main()
