def apply_prime(prime_count):
    """
    Apply precise prime number core stepping (2 -> 31) across available threads.
    Calculates operational capacity percentage and tunes governor/limits accordingly.
    """
    print(f"[*] Applying Prime Persona: P:{prime_count} ({prime_count} Cores Online)")
    set_keyboard_backlight_max()
    run_cmd("rfkill unblock wifi")
    set_radios(wifi=True, bluetooth=False)

    total_threads = get_total_cores()
    pct = round((prime_count / max(total_threads - 1, 1)) * 100)

    # Core allocation
    set_cpu_cores(count=prime_count)

    if prime_count <= 3:
        set_platform_profile("low-power")
        set_cpu_governor("powersave", epp="power")
        set_cpu_boost(False)
        set_gpu_power_level("lowlow")
    elif prime_count <= 11:
        set_platform_profile("balanced")
        set_cpu_governor("powersave", epp="balance_power")
        set_cpu_boost(False)
        set_gpu_power_level("four")
    elif prime_count <= 23:
        set_platform_profile("balanced")
        set_cpu_governor("powersave", epp="balance_performance")
        set_cpu_boost(True)
        set_gpu_power_level("four")
    else:
        set_platform_profile("performance")
        set_cpu_governor("performance", epp="performance")
        set_cpu_boost(True)
        set_gpu_power_level("auto")

    start_dev_stack()
    print(f"[-] CPU: {prime_count} threads active (~{pct}% system capacity)")
    print(f"[✓] System tuned to Prime {prime_count} (~{pct}% capacity).")
    launch_user_terminal(f"Prime {prime_count} ({prime_count} Cores / ~{pct}%)")

STATE_FILE = "/var/run/changestate.state"
TELEMETRY_LOG = "/var/log/changestate_telemetry.jsonl"

def collect_telemetry_snapshot(target_tier):
    """
    Capture high-density hardware and process telemetry snapshot for state transitions.
    Writes JSON Lines to /var/log/changestate_telemetry.jsonl and ingests into MongoDB.
    """
    now_iso = datetime.now(timezone.utc).isoformat()

    # 1. CPU Frequencies and Online Cores
    freqs = []
    for fpath in sorted(glob.glob("/sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq")):
        try:
            with open(fpath, "r") as f:
                freqs.append(int(f.read().strip()))
        except Exception:
            pass

    online_cores = "unknown"
    try:
        with open("/sys/devices/system/cpu/online", "r") as f:
            online_cores = f.read().strip()
    except Exception:
        pass

    # 2. Memory & Load
    mem_total_mb, mem_used_mb = 0, 0
    try:
        res = subprocess.run("free -m", shell=True, capture_output=True, text=True)
        for line in res.stdout.splitlines():
            if line.startswith("Mem:"):
                parts = line.split()
                mem_total_mb = int(parts[1])
                mem_used_mb = int(parts[2])
                break
    except Exception:
        pass

    load_avg = []
    try:
        with open("/proc/loadavg", "r") as f:
            load_avg = [float(x) for x in f.read().strip().split()[:3]]
    except Exception:
        pass

    # 3. Thermals & Fans (via sensors -j)
    sensors_data = {}
    try:
        res = subprocess.run("sensors -j", shell=True, capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            # sensors -j may have non-JSON error lines before JSON
            raw = res.stdout.strip()
            brace_pos = raw.find("{")
            if brace_pos != -1:
                sensors_data = json.loads(raw[brace_pos:])
    except Exception:
        pass

    # 4. Top 31+ CPU & RAM Process Snapshots (for deep pattern analysis & Granite 4.2 inferencing)
    top_procs = []
    try:
        res = subprocess.run(
            "ps -eo pid,ppid,user,%cpu,%mem,stat,time,comm,args --sort=-%cpu",
            shell=True, capture_output=True, text=True
        )
        if res.returncode == 0:
            lines = res.stdout.strip().splitlines()[1:33]  # Capture top 32 lines
            for l in lines:
                parts = l.split(None, 8)
                if len(parts) >= 8:
                    top_procs.append({
                        "pid": int(parts[0]),
                        "ppid": int(parts[1]),
                        "user": parts[2],
                        "cpu": float(parts[3]),
                        "mem": float(parts[4]),
                        "stat": parts[5],
                        "time": parts[6],
                        "comm": parts[7],
                        "cmd": parts[8] if len(parts) > 8 else parts[7]
                    })
    except Exception:
        pass

    # 5. Comprehensive GPU Telemetry (NVIDIA & AMD)
    gpus = []
    # NVIDIA Discovery via nvidia-smi
    if has_nvidia_gpu():
        try:
            q_fields = (
                "name,driver_version,pstate,temperature.gpu,utilization.gpu,"
                "utilization.memory,memory.total,memory.used,clocks.current.graphics,"
                "clocks.current.memory,power.draw,power.limit,pcie.link.gen.current"
            )
            res = subprocess.run(
                f"nvidia-smi --query-gpu={q_fields} --format=csv,noheader,nounits",
                shell=True, capture_output=True, text=True
            )
            if res.returncode == 0 and res.stdout.strip():
                for line in res.stdout.strip().splitlines():
                    p = [item.strip() for item in line.split(",")]
                    if len(p) >= 12:
                        def to_num(val, cast=float):
                            try:
                                return cast(val)
                            except Exception:
                                return None

                        gpus.append({
                            "vendor": "nvidia",
                            "model": p[0],
                            "driver": p[1],
                            "pstate": p[2],
                            "temp_c": to_num(p[3]),
                            "util_gpu_pct": to_num(p[4]),
                            "util_mem_pct": to_num(p[5]),
                            "vram_total_mb": to_num(p[6], int),
                            "vram_used_mb": to_num(p[7], int),
                            "clk_gfx_mhz": to_num(p[8]),
                            "clk_mem_mhz": to_num(p[9]),
                            "power_w": to_num(p[10]),
                            "power_limit_w": to_num(p[11]) if len(p) > 12 else None,
                            "pcie_gen": to_num(p[-1], int)
                        })
        except Exception:
            pass

    # AMD / Radeon Discovery via sysfs
    for card_dir in glob.glob("/sys/class/drm/card[0-9]/device"):
        try:
            vendor_path = os.path.join(card_dir, "vendor")
            if os.path.exists(vendor_path):
                with open(vendor_path, "r") as f:
                    if f.read().strip() == "0x1002":
                        def read_val(fname, cast=int, div=1):
                            fpath = os.path.join(card_dir, fname)
                            if os.path.exists(fpath):
                                with open(fpath, "r") as fl:
                                    return cast(fl.read().strip()) // div
                            return 0

                        vram_total = read_val("mem_info_vram_total", div=1048576)
                        vram_used = read_val("mem_info_vram_used", div=1048576)
                        gpu_busy = read_val("gpu_busy_percent")

                        gpus.append({
                            "vendor": "amd",
                            "vram_total_mb": vram_total,
                            "vram_used_mb": vram_used,
                            "util_gpu_pct": gpu_busy
                        })
        except Exception:
            pass

    # 6. Battery Status
    battery = {}
    try:
        with open("/sys/class/power_supply/BAT0/capacity", "r") as f:
            battery["percent"] = int(f.read().strip())
        with open("/sys/class/power_supply/BAT0/status", "r") as f:
            battery["status"] = f.read().strip()
    except Exception:
        pass

    # Assemble Document
    doc = {
        "timestamp": now_iso,
        "tier": target_tier,
        "online_cores": online_cores,
        "cpu_khz": freqs,
        "mem_used_mb": mem_used_mb,
        "mem_total_mb": mem_total_mb,
        "load": load_avg,
        "gpus": gpus,
        "battery": battery,
        "top_procs": top_procs,
        "sensors": sensors_data
    }

    # Write to /var/log/changestate_telemetry.jsonl
    json_line = json.dumps(doc)
    try:
        with open(TELEMETRY_LOG, "a") as f:
            f.write(json_line + "\n")
    except PermissionError:
        subprocess.run(f"echo '{json_line}' | sudo tee -a {TELEMETRY_LOG} > /dev/null", shell=True, check=False)
    except Exception:
        pass

    # Optional Mongo Ingestion (localhost:27017 -> db: telemetry, collection: state_snapshots)
    try:
        mongo_cmd = f"mongosh --quiet --eval \"db.getSiblingDB('telemetry').state_snapshots.insertOne({json_line})\""
        subprocess.run(mongo_cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1.5)
    except Exception:
        pass

def save_active_state(name):
    """Record the active persona name to STATE_FILE and log telemetry snapshot."""
    try:
        with open(STATE_FILE, "w") as f:
            f.write(name)
    except PermissionError:
        subprocess.run(f"echo {name} | sudo tee {STATE_FILE} > /dev/null", shell=True, check=False)
    except Exception:
        pass

    # Record telemetry snapshot
    collect_telemetry_snapshot(name)

def get_active_state():
    """Read the active persona name from STATE_FILE."""
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "untracked / manual"

def show_status():
    print("========================================")
    print(f" Active Persona  : {get_active_state().upper()}")
    print("========================================")
    try:
        with open("/sys/firmware/acpi/platform_profile", "r") as f:
            print(f"Platform Profile : {f.read().strip()}")
    except Exception:
        pass

    try:
        with open("/sys/devices/system/cpu/cpufreq/policy0/scaling_governor", "r") as f:
            print(f"CPU Governor     : {f.read().strip()}")
    except Exception:
        pass

    try:
        with open("/sys/devices/system/cpu/cpufreq/boost", "r") as f:
            boost_val = f.read().strip()
            print(f"CPU Boost        : {'Enabled' if boost_val == '1' else 'Disabled'}")
    except Exception:
        pass

    try:
        with open("/sys/devices/system/cpu/online", "r") as f:
            online = f.read().strip()
            total_hw = get_total_cores()
            print(f"Online Cores     : {online} (out of 0-{total_hw - 1})")
    except Exception:
        pass

    try:
        with open("/sys/devices/system/cpu/cpufreq/policy0/energy_performance_preference", "r") as f:
            print(f"CPU EPP          : {f.read().strip()}")
    except Exception:
        pass

    try:
        gpu_nodes = glob.glob("/sys/class/drm/card*/device/power_dpm_force_performance_level")
        if gpu_nodes:
            with open(gpu_nodes[0], "r") as f:
                print(f"GPU Power Level  : {f.read().strip()}")
        elif has_nvidia_gpu():
            res = subprocess.run(
                "nvidia-smi --query-gpu=power.draw,power.limit,clocks.gr --format=csv,noheader",
                shell=True, capture_output=True, text=True
            )
            if res.returncode == 0 and res.stdout.strip():
                parts = [p.strip() for p in res.stdout.strip().split(",")]
                draw, limit, clock = parts[0], parts[1], parts[2]
                print(f"GPU Status       : {draw} (Limit: {limit}, Clock: {clock})")
    except Exception:
        pass

    try:
        with open("/sys/class/power_supply/BAT0/capacity", "r") as f:
            cap = f.read().strip()
        with open("/sys/class/power_supply/BAT0/status", "r") as f:
            stat = f.read().strip()
        print(f"Battery          : {cap}% ({stat})")
    except Exception:
        pass

PERSONAS = {
    "lowlow": apply_lowlow,
    "four": apply_four,
    "eleven": apply_eleven,
    "mom": apply_mom,
    # Compatibility aliases
    "4": apply_four,
    "cruise": apply_four,
    "dev": apply_four,
    "mid": apply_four,
    "server": apply_lowlow,
    "webdev": apply_four,
    "inferencing": apply_eleven,
}

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print("Usage: changestate <persona>")
        print("\nAvailable personas:")
        print("  lowlow   - 1x Baseline (~20%): 6 Cores @ 1.6GHz, GPU 31W floor, Turbo OFF, Server/Ollama safe")
        print("  four     - 4x Cruising (75%): 24 Cores, GPU 70W, Turbo OFF, dev & gaming, chill fans (no nitrous)")
        print("  eleven   - 5x Open Throttle (100%): 32 Cores uncapped, GPU 97W ceiling, auto fans, full blast")
        print("  mom      - Defense / Submerged: RF cut, camera dead, 1 core only @ 1.1GHz, air-gapped")
        print("  status   - Show current active persona & hardware state")
        sys.exit(0)

    target = sys.argv[1].lower()

    if target == "status":
        show_status()
        return

    # Check for prime target syntax: p2, p3, p5, p7, p11, p13, p17, p19, p23, p29, p31 or just integer
    prime_val = None
    if target.startswith("p") and target[1:].isdigit():
        prime_val = int(target[1:])
    elif target.isdigit():
        prime_val = int(target)

    if prime_val is not None:
        apply_prime(prime_val)
        save_active_state(f"P:{prime_val}")
        run_cmd(f'notify-send "State Changed" "Activated Prime P:{prime_val} persona" -i preferences-system-power')
        return

    if target not in PERSONAS:
        print(f"Error: Unknown persona '{target}'")
        print(f"Choices: {', '.join(PERSONAS.keys())}")
        sys.exit(1)

    PERSONAS[target]()

    save_active_state(target)
    run_cmd(f'notify-send "State Changed" "Activated {target.upper()} persona" -i preferences-system-power')

if __name__ == "__main__":
    main()
