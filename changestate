#!/usr/bin/env python3
"""
changestate - Percentage-based Hardware Governor across Universal Prime Gears

Universal Prime Philosophy:
  Every prime notch is a standardized, universal capacity percentage for EVERY machine:
    P:2  = 6%   (Floor)
    P:3  = 10%
    P:5  = 16%
    P:7  = 23%
    P:11 = 35%
    P:13 = 42%
    P:17 = 55%
    P:19 = 61%
    P:23 = 75%  (The 75% Sweet Spot for dev & gaming everywhere)
    P:29 = 93%
    P:31 = 100% (Top gear)

Dynamic Diagnostics & 80% Max Safety Clamp:
  1. Auto-discovers machine specs: total CPU threads, min/max frequency, total RAM/Swap, GPU range.
  2. Dynamically calculates active cores for the host: round((pct / 100) * total_cores).
     - On a 8-core machine,  P:23 = 6 cores (75%).
     - On a 16-core machine, P:23 = 12 cores (75%).
     - On a 32-core machine, P:23 = 24 cores (75%).
     - On a 128-core server, P:23 = 96 cores (75%).
  3. Capped to 80% of silicon max:
     Target Freq = min + (pct / 100) * (0.80 * max - min)
     Even at 100% (P:31), clocks stop cleanly at 80% of max.
  4. Auto/Turbo boost disabled: No sudden spikes, no fan whine.
  5. BIOS fans left on auto: Safe thermal curve with zero board risk.
"""

import sys
import os
import glob
import subprocess
import json
from datetime import datetime, timezone

# Standardized Prime Percentage Map (Universal across all computers)
UNIVERSAL_PRIME_PCT = {
    2:  6,    # Floor (~6%)
    3:  10,   # ~10%
    5:  16,   # ~16%
    7:  23,   # ~23%
    11: 35,   # ~35%
    13: 42,   # ~42%
    17: 55,   # ~55%
    19: 61,   # ~61%
    23: 75,   # ~75% (The universal sweet spot)
    29: 93,   # ~93%
    31: 100   # 100% (mildly clamped at 80% of silicon max)
}

def run_cmd(cmd):
    """Run a shell command silently; ignore non-fatal errors."""
    try:
        subprocess.run(cmd, shell=True, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def write_sysfs(path_pattern, value):
    """Write value to one or more sysfs files matching path_pattern."""
    for path in glob.glob(path_pattern):
        if os.path.exists(path):
            try:
                with open(path, "w") as f:
                    f.write(str(value))
            except PermissionError:
                subprocess.run(f"echo {value} | sudo tee {path} > /dev/null", shell=True, check=False)
            except Exception as e:
                if getattr(e, "errno", None) != 16:
                    print(f"[!] Warning writing to {path}: {e}")

def is_intel_cpu():
    """Detect if running on an Intel CPU with intel_pstate."""
    return os.path.exists("/sys/devices/system/cpu/intel_pstate")

def has_nvidia_gpu():
    """Detect if NVIDIA GPU and driver tools are present."""
    import shutil
    return shutil.which("nvidia-smi") is not None

def discover_hardware():
    """
    Dynamically auto-discover hardware specifications of the current machine.
    Zero hardcoded values.
    """
    # 1. Total CPU threads
    cpu_nodes = glob.glob("/sys/devices/system/cpu/cpu[0-9]*")
    total_cores = max(len(cpu_nodes), 1)

    # 2. CPU Frequency Boundaries (kHz)
    min_freqs, max_freqs = [], []
    for p in glob.glob("/sys/devices/system/cpu/cpufreq/policy*"):
        try:
            with open(os.path.join(p, "cpuinfo_min_freq")) as f:
                min_freqs.append(int(f.read().strip()))
            with open(os.path.join(p, "cpuinfo_max_freq")) as f:
                max_freqs.append(int(f.read().strip()))
        except Exception:
            pass
    cpu_min_khz = min(min_freqs) if min_freqs else 800000
    cpu_max_khz = max(max_freqs) if max_freqs else 3000000

    # 3. RAM & Swap (MB)
    mem_total_mb, swap_total_mb = 0, 0
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    mem_total_mb = int(line.split()[1]) // 1024
                elif line.startswith("SwapTotal:"):
                    swap_total_mb = int(line.split()[1]) // 1024
    except Exception:
        pass

    # 4. GPU Discovery (NVIDIA & AMD)
    gpu = {"vendor": "none", "min_clk_mhz": 0, "max_clk_mhz": 0}
    if has_nvidia_gpu():
        gpu["vendor"] = "nvidia"
        try:
            res = subprocess.run(["nvidia-smi", "-q", "-d", "SUPPORTED_CLOCKS"], capture_output=True, text=True)
            if res.returncode == 0:
                clocks = []
                for l in res.stdout.splitlines():
                    if "Graphics" in l:
                        parts = l.split(":")
                        if len(parts) == 2:
                            clocks.append(int(parts[1].strip().split()[0]))
                if clocks:
                    gpu["min_clk_mhz"] = min(clocks)
                    gpu["max_clk_mhz"] = max(clocks)
        except Exception:
            pass

        # Fallback query if supported_clocks was restricted
        if not gpu["max_clk_mhz"]:
            try:
                res = subprocess.run(["nvidia-smi", "--query-gpu=clocks.max.graphics", "--format=csv,noheader"], capture_output=True, text=True)
                if res.returncode == 0 and res.stdout.strip().isdigit():
                    gpu["max_clk_mhz"] = int(res.stdout.strip())
                    gpu["min_clk_mhz"] = 210
            except Exception:
                pass

    return {
        "total_cores": total_cores,
        "cpu_min_khz": cpu_min_khz,
        "cpu_max_khz": cpu_max_khz,
        "mem_total_mb": mem_total_mb,
        "swap_total_mb": swap_total_mb,
        "gpu": gpu
    }

def get_gears_metadata():
    """Output universal gears metadata with machine-specific active core counts."""
    hw = discover_hardware()
    gears = []
    for p, pct in UNIVERSAL_PRIME_PCT.items():
        cores = max(1, round((pct / 100.0) * hw["total_cores"]))
        label = f"P:{p} (~{pct}%)"
        if p == 23:
            label = f"P:23 (~75% Sweet Spot)"
        elif p == 2:
            label = f"P:2 (~6% Floor)"
        elif p == 31:
            label = f"P:31 (100% / Mild 80% Cap)"

        gears.append({
            "id": f"p{p}",
            "prime": p,
            "pct": pct,
            "cores": cores,
            "total_cores": hw["total_cores"],
            "label": label
        })
    return gears

def set_cpu_cores(target_count):
    """Dynamically set the number of active CPU cores (Core 0 always online)."""
    total = discover_hardware()["total_cores"]
    target = min(max(target_count, 1), total)
    for i in range(1, total):
        state = 1 if i < target else 0
        write_sysfs(f"/sys/devices/system/cpu/cpu{i}/online", state)

def set_cpu_boost(enabled):
    """Enable or disable CPU turbo/boost across AMD and Intel CPUs."""
    if is_intel_cpu():
        write_sysfs("/sys/devices/system/cpu/intel_pstate/no_turbo", 0 if enabled else 1)
    else:
        write_sysfs("/sys/devices/system/cpu/cpufreq/boost", 1 if enabled else 0)

def set_cpu_freq_cap(max_khz):
    """Cap max CPU frequency across all online cores."""
    write_sysfs("/sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq", max_khz)

def set_cpu_governor(governor, epp=None):
    """Set CPU frequency scaling governor and energy_performance_preference."""
    write_sysfs("/sys/devices/system/cpu/cpufreq/policy*/scaling_governor", governor)
    epp_map = {
        "powersave": "power",
        "performance": "performance",
        "balanced": "balance_performance",
        "balance_power": "balance_power"
    }
    epp_val = epp if epp is not None else epp_map.get(governor, "default")
    write_sysfs("/sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference", epp_val)

def set_gpu_clamp(ratio, hw):
    """
    Clamp GPU clocks proportionally to ratio, locked under 80% ceiling.
    Auto-boost / Dynamic Boost strictly disabled.
    """
    if ratio <= 0.25:
        write_sysfs("/sys/class/drm/card*/device/power_dpm_force_performance_level", "low")
    else:
        write_sysfs("/sys/class/drm/card*/device/power_dpm_force_performance_level", "auto")

    if hw["gpu"]["vendor"] == "nvidia":
        # Always revoke auto-boost permission (no unexpected surges or fan ramps)
        run_cmd("nvidia-smi --auto-boost-permission=0")
        
        g_min = hw["gpu"]["min_clk_mhz"]
        g_max = hw["gpu"]["max_clk_mhz"]
        if g_max > g_min:
            # 80% maximum glass ceiling multiplier
            g_ceiling = int(g_min + ratio * (0.80 * g_max - g_min))
            run_cmd(f"nvidia-smi -lgc {g_min},{g_ceiling}")
        else:
            run_cmd("nvidia-smi -rgc")

def set_memory_swappiness(ratio):
    """
    Dynamically tune swappiness and dirty cache ratio:
    Low ratio: Aggressive flushing (cool RAM), low swappiness (minimize disk thrash).
    High ratio: Generous page caching for fast batch tensor loading without swapping.
    """
    target_swap = max(1, int(10 - ratio * 9))
    write_sysfs("/proc/sys/vm/swappiness", target_swap)

    target_dirty = int(10 + ratio * 10)
    write_sysfs("/proc/sys/vm/dirty_background_ratio", target_dirty)

def set_radios(wifi=True, bluetooth=False):
    """Control Wi-Fi and Bluetooth using rfkill."""
    run_cmd(f"rfkill {'unblock' if wifi else 'block'} wifi")
    run_cmd(f"rfkill {'unblock' if bluetooth else 'block'} bluetooth")

def set_camera_power(enabled=True):
    write_sysfs("/sys/devices/pci*/**/VPC2004:00/camera_power", 1 if enabled else 0)

def set_mic_mute(mute=False):
    run_cmd(f"amixer set Capture {'mute' if mute else 'unmute'}")

def set_aux_services(enable=True):
    services = ["cups", "cups-browsed", "ModemManager"]
    action = "start" if enable else "stop"
    for s in services:
        run_cmd(f"sudo systemctl {action} {s}")

def start_dev_stack():
    """Ensure developmental databases and LLM servers stay alive."""
    for s in ["mongod", "mongodb", "ollama"]:
        run_cmd(f"sudo systemctl start {s}")

def launch_user_terminal(banner_title):
    terminal_wanted = (
        "--terminal" in sys.argv
        or "-t" in sys.argv
        or os.environ.get("CHANGESTATE_TERMINAL") == "1"
    )
    if not terminal_wanted:
        cfg_file = os.path.expanduser("~dev/.config/changestate/config.json")
        if os.path.exists(cfg_file):
            try:
                with open(cfg_file) as f:
                    terminal_wanted = json.load(f).get("always_spawn_terminal", False)
            except Exception:
                pass

    if not terminal_wanted:
        return

    target_user = os.environ.get("SUDO_USER") or "dev"
    display = os.environ.get("DISPLAY") or ":0"
    dbus = "unix:path=/run/user/1000/bus"
    import shutil
    term_bin = "xfce4-terminal" if shutil.which("xfce4-terminal") else ("gnome-terminal" if shutil.which("gnome-terminal") else "x-terminal-emulator")
    
    if "xfce4-terminal" in term_bin:
        exec_arg = f"-T \"State: {banner_title}\" -e 'bash -c \"echo \\\"=== State: {banner_title} active ===\\\"; exec bash\"'"
    else:
        exec_arg = f"--title=\"State: {banner_title}\" -- bash -c \"echo \\\"=== State: {banner_title} active ===\\\"; exec bash\""

    cmd = (
        f"su - {target_user} -c 'DISPLAY={display} DBUS_SESSION_BUS_ADDRESS={dbus} "
        f"{term_bin} {exec_arg} &'"
    )
    subprocess.Popen(cmd, shell=True)

def apply_prime(prime_count):
    """
    Apply pure percentage-based hardware governor:
      - Uses UNIVERSAL_PRIME_PCT map (e.g. P:23 is always 75% for everyone)
      - Scales active cores: round((pct / 100) * total_cores)
      - Scales CPU clock ceiling: min_freq + ratio * (0.80 * max_freq - min_freq)
      - Scales GPU clock ceiling: min_gpu + ratio * (0.80 * max_gpu - min_gpu)
      - Disables all auto/turbo boost features across CPU & GPU
      - Preserves automatic BIOS fan curve for safety
    """
    hw = discover_hardware()
    total_threads = hw["total_cores"]

    # Match requested prime to universal percentage
    pct = UNIVERSAL_PRIME_PCT.get(prime_count)
    if pct is None:
        # Interpolate closest percentage if an unmapped prime is supplied
        if prime_count <= 2:
            pct = 6
        elif prime_count >= 31:
            pct = 100
        else:
            pct = round((prime_count / 31.0) * 100)

    ratio = pct / 100.0

    # Dynamically scale active cores for this host's topology
    active_cores = max(1, min(round(ratio * total_threads), total_threads))

    # 80% Max Safety Ceiling on CPU frequency
    target_cpu_khz = int(hw["cpu_min_khz"] + ratio * (0.80 * hw["cpu_max_khz"] - hw["cpu_min_khz"]))

    print(f"[*] Shifting to Prime P:{prime_count} (~{pct}% Capacity for this machine)")
    print(f"[*] Hardware Allocation: {active_cores}/{total_threads} Cores Online, CPU Cap {target_cpu_khz//1000} MHz (80% ceiling)")

    # Common devices
    write_sysfs("/sys/class/leds/platform::kbd_backlight/brightness", 2)
    set_camera_power(enabled=True)
    set_mic_mute(mute=False)
    run_cmd("sudo systemctl start avahi-daemon")
    set_aux_services(enable=True)
    set_radios(wifi=True, bluetooth=False)

    # 1. Physical Core Allocation
    set_cpu_cores(active_cores)

    # 2. Strict Turbo/Boost Disablement
    set_cpu_boost(False)

    # 3. Frequency Ceiling Clamp
    set_cpu_freq_cap(target_cpu_khz)

    # 4. CPU Governor / Energy Profile
    if ratio <= 0.25:
        write_sysfs("/sys/firmware/acpi/platform_profile", "low-power")
        set_cpu_governor("powersave", epp="power")
        write_sysfs("/sys/module/snd_hda_intel/parameters/power_save", 1)
        write_sysfs("/sys/module/pcie_aspm/parameters/policy", "powersupersave")
    elif ratio <= 0.65:
        write_sysfs("/sys/firmware/acpi/platform_profile", "balanced")
        set_cpu_governor("powersave", epp="balance_power")
        write_sysfs("/sys/module/snd_hda_intel/parameters/power_save", 0)
        write_sysfs("/sys/module/pcie_aspm/parameters/policy", "default")
    else:
        write_sysfs("/sys/firmware/acpi/platform_profile", "balanced")
        set_cpu_governor("powersave", epp="balance_performance")
        write_sysfs("/sys/module/snd_hda_intel/parameters/power_save", 0)
        write_sysfs("/sys/module/pcie_aspm/parameters/policy", "default")

    # 5. GPU Proportional Clamp (with 80% ceiling & no auto-boost)
    set_gpu_clamp(ratio, hw)

    # 6. Memory & Swappiness Optimization
    set_memory_swappiness(ratio)

    # 7. Keep LLM & Server stacks protected
    start_dev_stack()

    print(f"[-] Cores Online : {active_cores} / {total_threads} ({pct}%)")
    print(f"[-] CPU Ceiling  : {target_cpu_khz//1000} MHz (Capped, Boost OFF)")
    if hw["gpu"]["vendor"] == "nvidia":
        g_min = hw["gpu"]["min_clk_mhz"]
        g_max = hw["gpu"]["max_clk_mhz"]
        g_target = int(g_min + ratio * (0.80 * g_max - g_min)) if g_max else "N/A"
        print(f"[-] GPU Ceiling  : {g_target} MHz (Capped, Auto-Boost 0)")
    print(f"[-] Fans         : Auto-Managed BIOS (Safe acoustics)")
    print(f"[✓] Tuned to Prime P:{prime_count} (~{pct}% capacity).")
    launch_user_terminal(f"P:{prime_count} ({active_cores}/{total_threads} Cores / ~{pct}%)")

STATE_FILE = "/var/run/changestate.state"
TELEMETRY_LOG = "/var/log/changestate_telemetry.jsonl"

def collect_telemetry_snapshot(target_tier):
    now_iso = datetime.now(timezone.utc).isoformat()
    freqs = []
    for fpath in sorted(glob.glob("/sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq")):
        try:
            with open(fpath, "r") as f:
                freqs.append(int(f.read().strip()))
        except Exception:
            pass

    online_cores = "unknown"
    try:
        with open("/sys/devices/system/cpu/online", "r") as f:
            online_cores = f.read().strip()
    except Exception:
        pass

    mem_total_mb, mem_used_mb = 0, 0
    try:
        res = subprocess.run("free -m", shell=True, capture_output=True, text=True)
        for line in res.stdout.splitlines():
            if line.startswith("Mem:"):
                parts = line.split()
                mem_total_mb = int(parts[1])
                mem_used_mb = int(parts[2])
                break
    except Exception:
        pass

    battery = {}
    try:
        with open("/sys/class/power_supply/BAT0/capacity", "r") as f:
            battery["percent"] = int(f.read().strip())
        with open("/sys/class/power_supply/BAT0/status", "r") as f:
            battery["status"] = f.read().strip()
    except Exception:
        pass

    doc = {
        "timestamp": now_iso,
        "tier": target_tier,
        "online_cores": online_cores,
        "cpu_khz": freqs,
        "mem_used_mb": mem_used_mb,
        "mem_total_mb": mem_total_mb,
        "battery": battery
    }

    json_line = json.dumps(doc)
    try:
        with open(TELEMETRY_LOG, "a") as f:
            f.write(json_line + "\n")
    except PermissionError:
        subprocess.run(f"echo '{json_line}' | sudo tee -a {TELEMETRY_LOG} > /dev/null", shell=True, check=False)
    except Exception:
        pass

def save_active_state(name):
    try:
        with open(STATE_FILE, "w") as f:
            f.write(name)
    except PermissionError:
        subprocess.run(f"echo {name} | sudo tee {STATE_FILE} > /dev/null", shell=True, check=False)
    except Exception:
        pass
    collect_telemetry_snapshot(name)

def show_status():
    hw = discover_hardware()
    print("======================================================")
    print(" [*] CHANGESTATE HARDWARE STATUS")
    print("======================================================")
    try:
        with open(STATE_FILE, "r") as f:
            state = f.read().strip()
        print(f"Active Gear      : {state}")
    except Exception:
        print("Active Gear      : UNKNOWN")

    try:
        with open("/sys/devices/system/cpu/online", "r") as f:
            print(f"CPU Online Cores : {f.read().strip()} (of {hw['total_cores']} threads)")
    except Exception:
        pass

    try:
        with open("/sys/devices/system/cpu/intel_pstate/no_turbo", "r") as f:
            val = f.read().strip()
            print(f"Turbo/Boost      : {'DISABLED (Enforced)' if val == '1' else 'ENABLED'}")
    except Exception:
        pass

    try:
        with open("/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq", "r") as f:
            khz = int(f.read().strip())
            print(f"CPU Clock Ceiling: {khz // 1000} MHz (Hardware max: {hw['cpu_max_khz'] // 1000} MHz)")
    except Exception:
        pass

    try:
        with open("/proc/sys/vm/swappiness", "r") as f:
            print(f"VM Swappiness    : {f.read().strip()}")
    except Exception:
        pass

    if hw["gpu"]["vendor"] == "nvidia":
        try:
            res = subprocess.run(
                "nvidia-smi --query-gpu=power.draw,power.limit,clocks.gr --format=csv,noheader",
                shell=True, capture_output=True, text=True
            )
            if res.returncode == 0 and res.stdout.strip():
                parts = [p.strip() for p in res.stdout.strip().split(",")]
                print(f"GPU Draw / Clock : {parts[0]} / {parts[2]} (Limit: {parts[1]})")
        except Exception:
            pass

    try:
        with open("/sys/class/power_supply/BAT0/capacity", "r") as f:
            cap = f.read().strip()
        with open("/sys/class/power_supply/BAT0/status", "r") as f:
            stat = f.read().strip()
        print(f"Battery          : {cap}% ({stat})")
    except Exception:
        pass

def main():
    hw = discover_hardware()
    total_hw = hw["total_cores"]

    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print("Usage: changestate <prime_gear>")
        print("\nDiscovered Machine Hardware:")
        print(f"  CPU Threads : {total_hw}")
        print(f"  CPU Range   : {hw['cpu_min_khz']//1000} MHz - {hw['cpu_max_khz']//1000} MHz")
        print(f"  Total RAM   : {hw['mem_total_mb']} MB (Swap: {hw['swap_total_mb']} MB)")
        print(f"  GPU Vendor  : {hw['gpu']['vendor']} (Max Clock: {hw['gpu']['max_clk_mhz']} MHz)")
        print("\nUniversal Prime Gears (Scales across ANY host, 80% Max Cap):")
        for p, pct in UNIVERSAL_PRIME_PCT.items():
            cores = max(1, round((pct / 100.0) * total_hw))
            sweet = " (75% Sweet Spot)" if p == 23 else ""
            print(f"  p{p:<3} - P:{p:<2} (~{pct:>3}% Capacity -> {cores}/{total_hw} cores online{sweet})")
        print("  status     - Show current active gear & hardware status")
        print("  gears-json - Machine-tailored JSON metadata for Cinnamon applet")
        sys.exit(0)

    target = sys.argv[1].lower()

    if target == "status":
        show_status()
        return

    if target in ("gears-json", "gears"):
        print(json.dumps(get_gears_metadata()))
        return

    prime_val = None
    if target.startswith("p") and target[1:].isdigit():
        prime_val = int(target[1:])
    elif target.isdigit():
        prime_val = int(target)

    if prime_val is not None:
        apply_prime(prime_val)
        pct = UNIVERSAL_PRIME_PCT.get(prime_val, round((prime_val / 31.0) * 100))
        cores = max(1, round((pct / 100.0) * total_hw))
        save_active_state(f"P:{prime_val}")
        run_cmd(f'notify-send "Gear Shifted" "P:{prime_val} (~{pct}% Capacity / {cores} Cores / 80% Cap / Auto Fans)" -i preferences-system-power')
        return

    print(f"Error: Unknown gear '{target}'")
    valid_gears = [f"p{p}" for p in UNIVERSAL_PRIME_PCT.keys()]
    print(f"Choices: {', '.join(valid_gears)}, status, gears-json")
    sys.exit(1)

if __name__ == "__main__":
    main()
