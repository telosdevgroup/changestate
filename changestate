#!/usr/bin/env python3
"""
ChangeState: Discrete Prime-Core Stepping & Proportional Capacity Engine.
Enforces acoustic, thermal, and electrical sanity on Linux workstations.
"""

import sys
import os
import json
import subprocess

# Ensure changestate_core can be imported even if invoked via symlink or pkexec
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

from changestate_core.hal import run_cmd, write_sysfs, scaled_cap
from changestate_core.discovery import (
    UNIVERSAL_PRIME_PCT,
    discover_hardware,
    get_capacity_tiers_metadata
)
from changestate_core.controllers import (
    set_cpu_cores,
    set_cpu_boost,
    set_cpu_freq_cap,
    set_cpu_governor,
    set_gpu_clamp,
    set_memory_swappiness,
    set_radios,
    set_camera_power,
    set_mic_mute,
    engage_metal_posture,
    confirm_mom
)
from changestate_core.status import (
    save_active_state,
    show_status
)

def launch_user_terminal(banner_title, force=False):
    """Optionally spawn an interactive user terminal showing the new hardware state."""
    terminal_wanted = (
        force
        or "--terminal" in sys.argv
        or "-t" in sys.argv
        or os.environ.get("CHANGESTATE_TERMINAL") == "1"
    )
    if not terminal_wanted:
        cfg_file = os.path.expanduser("~dev/.config/changestate/config.json")
        if os.path.exists(cfg_file):
            try:
                with open(cfg_file) as f:
                    terminal_wanted = json.load(f).get("always_spawn_terminal", False)
            except Exception:
                pass

    if not terminal_wanted:
        return

    target_user = os.environ.get("SUDO_USER") or "dev"
    display = os.environ.get("DISPLAY") or ":0"
    dbus = "unix:path=/run/user/1000/bus"
    import shutil
    term_bin = "xfce4-terminal" if shutil.which("xfce4-terminal") else ("gnome-terminal" if shutil.which("gnome-terminal") else "x-terminal-emulator")
    
    if "xfce4-terminal" in term_bin:
        exec_arg = f'-T "State: {banner_title}" -e \'bash -c "echo \\\"=== State: {banner_title} active ===\\\"; exec bash"\''
    else:
        exec_arg = f'--title="State: {banner_title}" -- bash -c "echo \\\"=== State: {banner_title} active ===\\\"; exec bash"'

    cmd = (
        f"su - {target_user} -c 'DISPLAY={display} DBUS_SESSION_BUS_ADDRESS={dbus} "
        f"{term_bin} {exec_arg} &'"
    )
    subprocess.Popen(cmd, shell=True)

def apply_prime(prime_count):
    """
    Apply percentage-based capacity scaling or P:0 MOM defensive posture.
    """
    hw = discover_hardware()
    total_threads = hw["total_cores"]

    # Special handling for P:0 (MOM: Metal Over Moss)
    if prime_count == 0:
        pct = 0
        ratio = 0.0
        active_cores = 2
        target_cpu_khz = hw["cpu_min_khz"]

        print("[*] Engaging State MOM / P:0 (Metal Over Moss Defensive Posture)")
        print(f"[*] Hardware Allocation: {active_cores}/{total_threads} Cores Active, CPU Cap {target_cpu_khz//1000} MHz Floor")

        # Display / Keyboard: Backlight HIGH for dark ops
        write_sysfs("/sys/class/leds/platform::kbd_backlight/brightness", 2)
        set_camera_power(enabled=False)
        set_mic_mute(mute=True)

        # Physical Core Allocation & Clocks
        set_cpu_cores(active_cores)
        set_cpu_boost(False)
        set_cpu_freq_cap(target_cpu_khz)

        # Low power ACPI and powersupersave
        write_sysfs("/sys/firmware/acpi/platform_profile", "low-power")
        set_cpu_governor("powersave", epp="power")
        write_sysfs("/sys/module/snd_hda_intel/parameters/power_save", 1)
        write_sysfs("/sys/module/pcie_aspm/parameters/policy", "powersupersave")

        # GPU min clamp & memory swappiness floor
        set_gpu_clamp(0.0, hw)
        set_memory_swappiness(0.0)

        # Engage total radio silence, firewall shield, process cull
        engage_metal_posture(active=True)

        print(f"[-] Cores Active : {active_cores} / {total_threads} (P:0 Floor)")
        print(f"[-] CPU Ceiling  : {target_cpu_khz//1000} MHz (Floor, Boost OFF)")
        print(f"[-] Radios       : SILENT (All radios blocked, Ethernet jack active)")
        print(f"[-] Defenses     : Metal Shield Active (Inbound DROP, Dev/Games Culled)")
        print(f"[-] Backlight    : High (Dark-mode operations)")
        print("[✓] Metal Over Moss active.")
        launch_user_terminal("P:0 [MOM] Metal Over Moss Defensive Posture", force=True)
        return

    # Standard Prime Tiers (P:2 .. P:31)
    # Ensure defensive posture is disengaged
    engage_metal_posture(active=False)

    pct = UNIVERSAL_PRIME_PCT.get(prime_count)
    if pct is None:
        if prime_count <= 2:
            pct = 6
        elif prime_count >= 31:
            pct = 100
        else:
            pct = round((prime_count / 31.0) * 100)

    ratio = pct / 100.0
    active_cores = max(1, min(round(ratio * total_threads), total_threads))
    target_cpu_khz = scaled_cap(hw["cpu_min_khz"], hw["cpu_max_khz"], ratio)

    print(f"[*] Scaling to Prime P:{prime_count} (~{pct}% Capacity for this machine)")
    print(f"[*] Hardware Allocation: {active_cores}/{total_threads} Cores Active, CPU Cap {target_cpu_khz//1000} MHz (80% ceiling)")

    # Common devices
    write_sysfs("/sys/class/leds/platform::kbd_backlight/brightness", 2)
    set_camera_power(enabled=True)
    set_mic_mute(mute=False)
    set_radios(wifi=True, bluetooth=False)

    # 1. Physical Core Allocation
    set_cpu_cores(active_cores)

    # 2. Turbo/Boost Control & 3. Frequency Ceiling Clamp
    if ratio >= 1.0:
        set_cpu_boost(True)
        set_cpu_freq_cap(hw["cpu_max_khz"])
    else:
        set_cpu_boost(False)
        set_cpu_freq_cap(target_cpu_khz)

    # 4. CPU Governor / Energy Profile
    if ratio <= 0.25:
        write_sysfs("/sys/firmware/acpi/platform_profile", "low-power")
        set_cpu_governor("powersave", epp="power")
        write_sysfs("/sys/module/snd_hda_intel/parameters/power_save", 1)
        write_sysfs("/sys/module/pcie_aspm/parameters/policy", "powersupersave")
    elif ratio <= 0.65:
        write_sysfs("/sys/firmware/acpi/platform_profile", "balanced")
        set_cpu_governor("powersave", epp="balance_power")
        write_sysfs("/sys/module/snd_hda_intel/parameters/power_save", 0)
        write_sysfs("/sys/module/pcie_aspm/parameters/policy", "default")
    elif ratio < 1.0:
        write_sysfs("/sys/firmware/acpi/platform_profile", "balanced")
        set_cpu_governor("powersave", epp="balance_performance")
        write_sysfs("/sys/module/snd_hda_intel/parameters/power_save", 0)
        write_sysfs("/sys/module/pcie_aspm/parameters/policy", "default")
    else:
        write_sysfs("/sys/firmware/acpi/platform_profile", "performance")
        set_cpu_governor("performance", epp="performance")
        write_sysfs("/sys/module/snd_hda_intel/parameters/power_save", 0)
        write_sysfs("/sys/module/pcie_aspm/parameters/policy", "performance")

    # 5. GPU Proportional Clamp
    set_gpu_clamp(ratio, hw)

    # 6. Memory & Swappiness Optimization
    set_memory_swappiness(ratio)

    print(f"[-] Cores Active : {active_cores} / {total_threads} ({pct}%)")
    if ratio >= 1.0:
        print(f"[-] CPU Ceiling  : {hw['cpu_max_khz']//1000} MHz (Uncapped, Turbo ON, Performance)")
    else:
        print(f"[-] CPU Ceiling  : {target_cpu_khz//1000} MHz (Capped, Boost OFF)")
    if hw["gpu"]["vendor"] == "nvidia":
        if ratio >= 1.0:
            p_def = hw["gpu"].get("power_default_w")
            tgp = f"{p_def}W TGP" if p_def else "factory TGP"
            print(f"[-] GPU Status   : Uncapped ({hw['gpu']['max_clk_mhz']} MHz Max, {tgp}, Auto-Boost ON)")
        else:
            print(f"[-] GPU Status   : Safe Clocks (-rgc reset, Auto-Boost 0, Display Protected)")
    print(f"[-] Fans         : Auto-Managed BIOS (Safe acoustics)")
    print(f"[✓] Elastic capacity adjusted to Prime P:{prime_count} (~{pct}% capacity).")
    launch_user_terminal(f"P:{prime_count} ({active_cores}/{total_threads} Cores / ~{pct}%)")

def main():
    hw = discover_hardware()
    total_hw = hw["total_cores"]

    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print("Usage: changestate <capacity_tier>")
        print("\nDiscovered Machine Hardware:")
        print(f"  CPU Threads : {total_hw}")
        print(f"  CPU Range   : {hw['cpu_min_khz']//1000} MHz - {hw['cpu_max_khz']//1000} MHz")
        print(f"  Total RAM   : {hw['mem_total_mb']} MB (Swap: {hw['swap_total_mb']} MB)")
        print(f"  GPU Vendor  : {hw['gpu']['vendor']} (Max Clock: {hw['gpu']['max_clk_mhz']} MHz)")
        print("\nUniversal Capacity Tiers (Scales across ANY host, 80% Max Cap):")
        print(f"  p0 (mom) - P:0  (MOM: Metal Over Moss Defensive Posture -> 2 cores / Airgap / Firewall; asks you to type MOM, or pass --confirm)")
        for p, pct in UNIVERSAL_PRIME_PCT.items():
            cores = max(1, round((pct / 100.0) * total_hw))
            sweet = " (75% Balanced Capacity)" if p == 23 else ""
            print(f"  p{p:<3} - P:{p:<2} (~{pct:>3}% Capacity -> {cores}/{total_hw} cores active{sweet})")
        print("  status     - Show current active capacity & hardware diagnostics")
        print("  tiers-json - Machine-tailored JSON metadata for Cinnamon applet")
        sys.exit(0)

    target = sys.argv[1].lower()

    if target == "status":
        show_status()
        return

    if target in ("tiers-json", "tiers", "gears-json", "gears"):
        print(json.dumps(get_capacity_tiers_metadata()))
        return

    if target in ("mom", "p0", "0"):
        if not confirm_mom("--confirm" in sys.argv):
            sys.exit(1)
        apply_prime(0)
        save_active_state("P:0 (MOM)")
        run_cmd('notify-send "ChangeState" "Engaged P:0 [MOM] Metal Over Moss Defensive Posture" -i security-high')
        return

    prime_val = None
    if target.startswith("p") and target[1:].isdigit():
        prime_val = int(target[1:])
    elif target.isdigit():
        prime_val = int(target)

    if prime_val is not None:
        apply_prime(prime_val)
        pct = UNIVERSAL_PRIME_PCT.get(prime_val, round((prime_val / 31.0) * 100))
        cores = max(1, round((pct / 100.0) * total_hw))
        save_active_state(f"P:{prime_val}")
        cap_desc = "Uncapped Full Performance" if pct >= 100 else "80% Cap"
        run_cmd(f'notify-send "Capacity Scaled" "P:{prime_val} (~{pct}% Capacity / {cores} Cores / {cap_desc} / Auto Fans)" -i preferences-system-power')
        return

    print(f"Error: Unknown capacity tier '{target}'")
    valid_tiers = ["mom (p0)", "max (p31)"] + [f"p{p}" for p in UNIVERSAL_PRIME_PCT.keys()]
    print(f"Choices: {', '.join(valid_tiers)}, status, tiers-json")
    sys.exit(1)

if __name__ == "__main__":
    main()
