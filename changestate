#!/usr/bin/env python3
"""
changestate - System persona switcher for Lenovo ThinkBook (AMD Ryzen)
Personas:
  1. radiosilent (low-power, extreme battery, radios cut)
  2. webdev      (mid-power, balanced, wifi on, snappy dev environment)
  3. inferencing (high-power, maximum performance, cpu boost, heavy workloads)
"""

import sys
import os
import glob
import subprocess

def run_cmd(cmd):
    """Run a shell command silently; ignore non-fatal errors."""
    try:
        subprocess.run(cmd, shell=True, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def write_sysfs(path_pattern, value):
    """Write value to one or more sysfs files matching path_pattern."""
    for path in glob.glob(path_pattern):
        if os.path.exists(path):
            try:
                with open(path, "w") as f:
                    f.write(str(value))
            except PermissionError:
                # Fallback to sudo tee if run without root
                subprocess.run(f"echo {value} | sudo tee {path} > /dev/null", shell=True, check=False)
            except Exception as e:
                # Silently ignore offline CPU policy nodes (Device or resource busy)
                if getattr(e, "errno", None) != 16:
                    print(f"[!] Warning writing to {path}: {e}")

def is_intel_cpu():
    """Detect if running on an Intel CPU with intel_pstate."""
    return os.path.exists("/sys/devices/system/cpu/intel_pstate")

def has_nvidia_gpu():
    """Detect if NVIDIA GPU and driver tools are present."""
    import shutil
    return shutil.which("nvidia-smi") is not None

def set_platform_profile(profile):
    """Set ACPI platform profile (low-power, balanced, performance) if supported."""
    write_sysfs("/sys/firmware/acpi/platform_profile", profile)

def set_cpu_governor(governor):
    """Set CPU frequency scaling governor and energy_performance_preference across all cores."""
    write_sysfs("/sys/devices/system/cpu/cpufreq/policy*/scaling_governor", governor)
    epp_map = {
        "powersave": "power",
        "performance": "performance",
        "balanced": "balance_performance",
        "balance_power": "balance_power"
    }
    epp_val = epp_map.get(governor, "default")
    write_sysfs("/sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference", epp_val)

def set_cpu_boost(enabled):
    """
    Enable or disable CPU turbo/boost across AMD and Intel CPUs:
    - AMD: /sys/devices/system/cpu/cpufreq/boost (1=enabled, 0=disabled)
    - Intel: /sys/devices/system/cpu/intel_pstate/no_turbo (0=enabled, 1=disabled)
    """
    if is_intel_cpu():
        write_sysfs("/sys/devices/system/cpu/intel_pstate/no_turbo", 0 if enabled else 1)
    else:
        write_sysfs("/sys/devices/system/cpu/cpufreq/boost", 1 if enabled else 0)

def set_radios(wifi=True, bluetooth=False):
    """Control Wi-Fi and Bluetooth using rfkill."""
    if wifi:
        run_cmd("rfkill unblock wifi")
    else:
        run_cmd("rfkill block wifi")

    if bluetooth:
        run_cmd("rfkill unblock bluetooth")
    else:
        run_cmd("rfkill block bluetooth")

def set_cpu_freq_cap(max_khz=None):
    """Cap max CPU frequency across all cores (or restore to hardware max)."""
    if max_khz is None:
        try:
            with open("/sys/devices/system/cpu/cpufreq/policy0/cpuinfo_max_freq", "r") as f:
                max_khz = f.read().strip()
        except Exception:
            max_khz = 5000000
    write_sysfs("/sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq", max_khz)

def set_gpu_power_level(level):
    """
    Set GPU dynamic power management level for AMD Radeon and NVIDIA:
    - AMD: power_dpm_force_performance_level ('low', 'auto')
    - NVIDIA: nvidia-smi clock locks and power management
    """
    # 1. AMD Radeon GPUs
    write_sysfs("/sys/class/drm/card*/device/power_dpm_force_performance_level", level)

    # 2. NVIDIA GPUs
    if has_nvidia_gpu():
        if level == "low":
            # Lock NVIDIA GPU clocks down to power-saving floor (e.g., 300MHz)
            run_cmd("nvidia-smi -lgc 300,600")
            run_cmd("nvidia-smi --auto-boost-permission=0")
        else:
            # Reset NVIDIA GPU clocks back to unlocked dynamic scaling
            run_cmd("nvidia-smi -rgc")
            run_cmd("nvidia-smi --auto-boost-permission=1")

def manage_service(service_name, action):
    """Start or stop systemd services if present."""
    run_cmd(f"sudo systemctl {action} {service_name}")

def get_total_cores():
    """Detect total number of CPU logical threads on the machine."""
    import glob
    nodes = glob.glob("/sys/devices/system/cpu/cpu[0-9]*")
    return max(len(nodes), 1)

def set_cpu_cores(count=None):
    """
    Set the number of online CPU cores/threads dynamically.
    Core 0 is always online.
    count=1    -> Single core only (MOM)
    count='half' -> 50% of available CPU cores online (MID)
    count=None   -> All cores online (ELEVEN)
    """
    total = get_total_cores()
    if count == "half":
        target = max(total // 2, 1)
    elif isinstance(count, int):
        target = min(max(count, 1), total)
    else:
        target = total

    for i in range(1, total):
        state = 1 if i < target else 0
        write_sysfs(f"/sys/devices/system/cpu/cpu{i}/online", state)

def set_camera_power(enabled=True):
    """Enable or disable hardware power to the webcam sensor on Lenovo."""
    write_sysfs("/sys/devices/pci*/**/VPC2004:00/camera_power", 1 if enabled else 0)

def set_firewall_lockdown(enable=False):
    """Enforce incoming DROP firewall policy."""
    if enable:
        run_cmd("sudo ufw default deny incoming")
        run_cmd("sudo ufw enable")

def launch_user_terminal(persona_title):
    """Spawn a user terminal showing the new persona banner and prompt in XFCE / Cinnamon."""
    target_user = os.environ.get("SUDO_USER") or "dev"
    display = os.environ.get("DISPLAY") or ":0"
    dbus = "unix:path=/run/user/1000/bus"
    import shutil
    term_bin = "xfce4-terminal" if shutil.which("xfce4-terminal") else ("gnome-terminal" if shutil.which("gnome-terminal") else "x-terminal-emulator")
    
    if "xfce4-terminal" in term_bin:
        exec_arg = f"-T \"State: {persona_title}\" -e 'bash -c \"echo \\\"=== State: {persona_title} active ===\\\"; exec bash\"'"
    else:
        exec_arg = f"--title=\"State: {persona_title}\" -- bash -c \"echo \\\"=== State: {persona_title} active ===\\\"; exec bash\""

    cmd = (
        f"su - {target_user} -c 'DISPLAY={display} DBUS_SESSION_BUS_ADDRESS={dbus} "
        f"{term_bin} {exec_arg} &'"
    )
    subprocess.Popen(cmd, shell=True)

def set_audio_power_save(enable=True):
    """Enable 1-second auto power down for audio codec, or disable for zero latency."""
    val = 1 if enable else 0
    write_sysfs("/sys/module/snd_hda_intel/parameters/power_save", val)

def set_pcie_aspm(policy="default"):
    """Set PCIe Active State Power Management policy (e.g. powersupersave or default)."""
    write_sysfs("/sys/module/pcie_aspm/parameters/policy", policy)

def set_keyboard_backlight_max():
    """Ensure keyboard backlight stays locked at 100% (level 2 of 2)."""
    write_sysfs("/sys/class/leds/platform::kbd_backlight/brightness", 2)

def set_mic_mute(mute=True):
    """Hard mute or unmute microphone capture channels via ALSA."""
    action = "mute" if mute else "unmute"
    run_cmd(f"amixer set Capture {action}")

def set_aux_services(enable=True):
    """Control auxiliary background services (cups printing, modemmanager, bluetooth)."""
    services = ["cups", "cups-browsed", "ModemManager"]
    action = "start" if enable else "stop"
    for s in services:
        manage_service(s, action)

