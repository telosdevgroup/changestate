def set_tray_icons(enable=True):
    """
    Clear or restore desktop panel tray icons:
    Bluetooth tray (blueman), Mint Update indicator, Mint Report, and Printer notifications.
    """
    set_cinnamon_applets(enable)
    if not enable:
        # Kill tray applet and printer notification processes
        tray_procs = [
            "blueman-applet", "blueman-tray", "mintupdate-launcher",
            "mintUpdate", "mintreport", "applet.py", "csd-print-notifications",
            "csd-printer", "scp-dbus-service"
        ]
        for p in tray_procs:
            run_cmd(f"sudo pkill -9 -i -f {p}")
    else:
        # Spawn back standard user applets if not already running
        target_user = os.environ.get("SUDO_USER") or "dev"
        cmd = (
            f"su - {target_user} -c 'DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus "
            f"sh -c \"blueman-applet >/dev/null 2>&1 & "
            f"mintupdate-launcher >/dev/null 2>&1 & "
            f"/usr/share/system-config-printer/applet.py >/dev/null 2>&1 &\"'"
        )
        subprocess.Popen(cmd, shell=True)

def purge_heavy_stacks():
    """Immediately terminate heavy services, databases, game clients, and runtimes."""
    stacks = [
        "docker", "containerd", "mongod", "mongodb",
        "redis-server", "redis", "celery"
    ]
    for s in stacks:
        manage_service(s, "stop")

    # Patterns of processes to kill on sight (only in MOM emergency lockdown)
    kill_patterns = [
        "steam",
        "steamwebhelper",
        "Battle.net",
        "Battle.net.exe",
        "Agent.exe",
        "tsm",
        "TSM",
        "TradeSkillMaster",
        "redis-server",
        "redis",
        "celery",
        "postgres",
        "mysqld"
    ]
    for p in kill_patterns:
        run_cmd(f"sudo pkill -9 -i -f {p}")

def start_dev_stack():
    """Ensure MongoDB and Ollama services are active."""
    for s in ["mongod", "mongodb", "ollama"]:
        manage_service(s, "start")

